{
  "name": "arc-control-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meridian Commerce — a synthetic enterprise integration test harness for ARC Control 2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/start.mjs",
    "live": "node src/start.mjs --live",
    "live:check": "node src/live-check.mjs",
    "lab": "node tools/lab.mjs",
    "lab:links": "node tools/lab.mjs --links",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node src/smoke.mjs",
    "preflight": "node src/preflight.mjs",
    "validate": "node src/report.mjs",
    "phase2": "node src/phase2-report.mjs",
    "ui:install": "npm --prefix ui ci",
    "ui:dev": "npm --prefix ui run dev",
    "ui:typecheck": "npm --prefix ui run typecheck",
    "ui:build": "npm --prefix ui run build",
    "product": "node src/product-report.mjs",
    "coverage": "node src/coverage-report.mjs",
    "showcase": "node src/showcase.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  }
}
